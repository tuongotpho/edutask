rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let data = getUserData();
      return data != null && data.roles.hasAny(['ADMIN', 'PRINCIPAL', 'VICE_PRINCIPAL']);
    }
    
    function isDeptLeader(deptId) {
      let data = getUserData();
      return data != null && 
             data.departmentId == deptId && 
             data.roles.hasAny(['HEAD_OF_DEPT', 'GROUP_LEADER']);
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isAdmin() || request.auth.uid == userId);
      allow update: if isAuth() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'status', 'departmentId']))
      );
      allow delete: if isAdmin();
    }
    
    match /leaves/{leaveId} {
      allow read: if isAuth() && (
        isAdmin() || 
        resource.data.applicantId == request.auth.uid ||
        resource.data.substituteTeacherId == request.auth.uid ||
        isDeptLeader(resource.data.departmentId)
      );
      
      allow write: if isAuth() && (
        isAdmin() || 
        request.resource.data.applicantId == request.auth.uid ||
        isDeptLeader(request.resource.data.departmentId)
      );
    }
    
    match /tasks/{taskId} {
      allow read: if isAuth() && (
        isAdmin() || 
        (request.auth.uid in resource.data.viewerIds)
      );
      
      allow create: if isAuth();
      
      allow update: if isAuth() && (
        isAdmin() || 
        resource.data.assignerId == request.auth.uid ||
        (request.auth.uid in resource.data.viewerIds)
      );
      
      allow delete: if isAuth() && (
        isAdmin() || 
        resource.data.assignerId == request.auth.uid
      );
    }
    
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.recipientUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuth() && resource.data.recipientUserId == request.auth.uid;
    }
  }
}
