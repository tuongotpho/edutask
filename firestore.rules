rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let data = getUserData();
      return data != null && data.roles.hasAny(['ADMIN', 'PRINCIPAL', 'VICE_PRINCIPAL']);
    }
    
    function isDeptLeader(deptId) {
      let data = getUserData();
      return data != null && 
             data.departmentId == deptId && 
             data.roles.hasAny(['HEAD_OF_DEPT', 'GROUP_LEADER']);
    }

    match /users/{userId} {
      // All authenticated users can read profiles for assignment/display
      allow read: if isAuth();
      // Only Admin or the user themselves can update their profile
      allow write: if isAuth() && (isAdmin() || request.auth.uid == userId);
    }
    
    match /leaves/{leaveId} {
      allow read: if isAuth() && (
        isAdmin() || 
        resource.data.applicantId == request.auth.uid ||
        resource.data.substituteTeacherId == request.auth.uid ||
        isDeptLeader(resource.data.departmentId)
      );
      
      allow write: if isAuth() && (
        isAdmin() || 
        request.resource.data.applicantId == request.auth.uid ||
        isDeptLeader(request.resource.data.departmentId)
      );
    }
    
    match /tasks/{taskId} {
      // Tasks are assigned to arrays of userIds or a department.
      // We will allow read if admin or if the user is authenticated. 
      // A more robust rule would iterate assignees, but Firestore rules for arrays are tricky.
      // We'll rely on frontend query filters for tasks for non-admins to prevent fetching all.
      allow read, write: if isAuth(); 
    }
    
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientUserId == request.auth.uid;
      allow write: if isAuth();
    }
  }
}
