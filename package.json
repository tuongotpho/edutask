{
  "name": "edutask",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-messaging-sw.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-messaging-sw.mjs",
    "build": "next build && node scripts/build-sw-precache.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-edutask-rules \"vitest run --config vitest.rules.config.mts\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project app-from-ai",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project app-from-ai",
    "deploy:push": "cross-env-shell FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:onNotificationCreated --project app-from-ai",
    "deploy:telegram": "cross-env-shell FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:onLeaveCreatedTelegram,functions:onLeaveDecidedTelegram,functions:onTaskCreatedTelegram --project app-from-ai",
    "deploy:schedulers": "firebase deploy --only functions:runReminderSchedules,functions:dailyDueDigest --project app-from-ai",
    "clean": "next clean"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "puppeteer": "^25.4.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
